{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heli-harness.dev/schemas/benchmark-experiment-v1.json",
  "title": "Heli Benchmark Experiment v1",
  "type": "object",
  "required": ["schemaVersion", "experimentId", "scenario", "promptIdentity", "baselineIdentity", "runs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "experimentId": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "promptIdentity": { "type": "string", "minLength": 1 },
    "baselineIdentity": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["runId", "mode", "promptIdentity", "baselineIdentity", "metrics"],
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "promptIdentity": { "type": "string", "minLength": 1 },
          "baselineIdentity": { "type": "string", "minLength": 1 },
          "metrics": { "type": "object" },
          "overhead": { "type": "object", "additionalProperties": { "type": "number" } },
          "benefit": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
